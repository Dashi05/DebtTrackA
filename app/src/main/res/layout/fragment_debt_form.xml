<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Новый долг"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/typeToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/typeOwedToMeButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Мне должны" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/typeIOweButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Я должен" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Имя -->
            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="20dp"
                android:text="ИМЯ ЧЕЛОВЕКА *" />

            <EditText
                android:id="@+id/personNameEditText"
                style="@style/FormField"
                android:layout_marginTop="6dp"
                android:hint="Введите имя или выберите из контактов"
                android:inputType="textPersonName" />

            <TextView
                android:id="@+id/personNameError"
                style="@style/FormError"
                android:text="Укажите имя человека" />

            <!-- Сумма -->
            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="16dp"
                android:text="СУММА *" />

            <EditText
                android:id="@+id/amountEditText"
                style="@style/FormField"
                android:layout_marginTop="6dp"
                android:hint="0"
                android:inputType="numberDecimal" />

            <TextView
                android:id="@+id/amountError"
                style="@style/FormError"
                android:text="Укажите сумму больше нуля" />

            <!-- Срок возврата -->
            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="16dp"
                android:text="СРОК ВОЗВРАТА *" />

            <LinearLayout
                android:id="@+id/dueDateField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/dueDateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Выберите дату"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Категория -->
            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="16dp"
                android:text="КАТЕГОРИЯ" />

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:padding="14dp" />

            <!-- Описание -->
            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="16dp"
                android:text="ОПИСАНИЕ" />

            <EditText
                android:id="@+id/descriptionEditText"
                style="@style/FormField"
                android:layout_marginTop="6dp"
                android:layout_height="100dp"
                android:gravity="top|start"
                android:hint="Необязательно"
                android:inputType="textMultiLine" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="@color/primary"
                android:text="Сохранить долг"
                android:textAllCaps="false"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
