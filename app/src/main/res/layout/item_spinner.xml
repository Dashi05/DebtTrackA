<?xml version="1.0" encoding="utf-8"?>
<!--
    Свёрнутый элемент выпадающего списка.

    Нужен вместо android.R.layout.simple_spinner_item: тот берёт цвет из
    системного атрибута textColorPrimary, который в тёмной теме становится
    белым — на светлой подложке приложения текст пропадал.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:textColor="@color/text_primary"
    android:textSize="15sp" />
